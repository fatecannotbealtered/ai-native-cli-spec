      "type": "enum",
      "required": false,
      "enum": ["json", "text", "raw"],
      "default": "json",
      "description": "Output format; json is the contract"
    },
    {
      "name": "json",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Alias of --format json"
    },
    {
      "name": "pretty",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Indent the JSON"
    },
    {
      "name": "compact",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Accepted no-op; compact is the default"
    },
    {
      "name": "fields",
      "kind": "flag",
      "type": "string",
      "required": false,
      "multiple": true,
      "description": "a,b replaces the default fields; +a adds; all returns everything"
    },
    {
      "name": "quiet",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Suppress non-error stderr"
    },
    {
      "name": "dry-run",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Return the preview and a confirm token; change nothing"
    },
    {
      "name": "confirm",
      "kind": "flag",
      "type": "string",
      "required": false,
      "description": "Execute the previewed write with its token"
    },
    {
      "name": "dangerous",
      "kind": "flag",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Required in both steps for dangerous commands"
    }

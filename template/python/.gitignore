# Python-specific — append to common/.gitignore
#
# Never ignore {{TOOL_PKG}}/_aicli/: it is the vendored ai-native-cli-spec
# library (scripts/sync-spec.js writes it, scripts/check-spec.js verifies it)
# and is committed like the rest of the source. Its __pycache__/ is ignored
# below like any other.

# Byte-compiled / cache
__pycache__/
*.py[cod]

# Packaging / build artifacts
*.egg-info/
*.egg
build/
dist/

# Virtual environments
.venv/
venv/

# Test / coverage / lint caches
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# PyInstaller
*.spec
*.manifest

# Derived release artifact — must not be committed
release-notes.md
